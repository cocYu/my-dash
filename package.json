{
  "name": "mydash",
  "version": "0.1.0",
  "description": "Electron + Go + SQLite 桌面应用骨架",
  "main": "out/main/index.js",
  "author": "myDash",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-backend.mjs dev && electron-vite dev",
    "backend:dev": "node scripts/build-backend.mjs dev",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "node scripts/build-backend.mjs release && electron-vite build && electron-builder --win nsis",
    "build:dir": "node scripts/build-backend.mjs release && electron-vite build && electron-builder --win nsis --dir"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/outfit": "^5.3.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.21.1",
    "codemirror": "^6.0.2",
    "cron-parser": "^5.10.6",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.8",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-table-of-contents": "^1.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
